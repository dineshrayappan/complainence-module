    {
      "name": "Complaints (NC & CAP Defect Logs)",
      "item": [
        {
          "name": "Get All Complaints (with Filters)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/complaints?tab=all",
              "host": ["{{baseUrl}}"],
              "path": ["complaints"],
              "query": [
                {
                  "key": "tab",
                  "value": "all",
                  "description": "all | open | action-pending | cap-submitted | under-review | closed | overdue"
                }
              ]
            }
          }
        },
        {
          "name": "Create NC Defect Ticket",
          "request": {
            "method": "POST",
            "header": [
